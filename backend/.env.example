APP_ENV=local
# Local Docker connection. For Azure, remove DATABASE_URL and use the separate fields below.
DATABASE_URL=mysql+pymysql://pickup_app:pickup_local@localhost:3306/pickup?charset=utf8mb4
DATABASE_SSL=false
